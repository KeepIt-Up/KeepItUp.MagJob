{
  "ConnectionStrings": {
    "DefaultConnection": "DEFAULT_CONNECTION_STRING"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log.txt",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Mailserver": {
    "Server": "mailhog",
    "Port": 1025,
    "EnableSsl": false,
    "Username": "",
    "Password": "",
    "FromEmail": "noreply@magjob.com",
    "FromName": "MagJob"
  },
  "FileStorage": {
    "BasePath": "./wwwroot/uploads",
    "BaseUrl": "http://localhost:5000/api/identity/uploads"
  },
  "KeycloakAdmin": {
    "ServerUrl": "KEYCLOAK_SERVER_URL",
    "Realm": "keepitup-magjob",
    "ClientId": "keepitup-magjob-identity",
    "ClientSecret": "KEYCLOAK_CLIENT_SECRET",
    "RequireHttps": false,
    "TokenExpirationSeconds": 300,
    "TimeoutSeconds": 30,
    "AdminUsername": "admin",
    "AdminPassword": "admin",
    "AdminClientId": "admin-cli"
  },
  "KeycloakClient": {
    "ServerUrl": "KEYCLOAK_SERVER_URL",
    "Realm": "keepitup-magjob",
    "ClientId": "keepitup-magjob-client",
    "RequireHttps": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "http://localhost:80",
      "http://identity:5000",
      "http://localhost:5000"
    ]
  },
  "HealthChecks": {
    "Database": {
      "Enabled": true,
      "Timeout": "00:00:30"
    },
    "Keycloak": {
      "Enabled": true,
      "Timeout": "00:00:10"
    },
    "System": {
      "Memory": {
        "Enabled": true,
        "MaxMemoryMB": 1024
      },
      "Disk": {
        "Enabled": true,
        "MinFreeMB": 1024,
        "DriveName": ""
      }
    },
    "Email": {
      "Enabled": true,
      "Timeout": "00:00:10"
    }
  }
}
